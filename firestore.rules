
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. FUNÇÕES DE SEGURANÇA
    // ==========================================

    function signed() {
      return request.auth != null;
    }

    function isAdmin() {
      return signed() && request.auth.token.admin == true;
    }

    function isOwner(schoolId) {
      return signed() && request.auth.uid == schoolId;
    }

    function schoolApproved() {
      return signed()
        && exists(/databases/$(database)/documents/schools/$(request.auth.uid))
        && get(/databases/$(database)/documents/schools/$(request.auth.uid)).data.status == 'approved';
    }

    function surveyPublished(surveyId) {
      return exists(/databases/$(database)/documents/surveys/$(surveyId))
        && get(/databases/$(database)/documents/surveys/$(surveyId)).data.status == 'published';
    }

    function validVals(v) {
      return v is map
        && v.keys().hasAll([
          'total', 'impact', 'cont', 'uniB', 'uniA'
        ])
        && v.total is number
        && v.impact is number
        && v.cont is number
        && v.uniB is number
        && v.uniA is number
        && v.total > 0
        && v.impact >= 0
        && v.cont >= 0
        && v.uniB >= 0
        && v.uniA >= 0
        && v.impact <= v.total
        && v.cont <= v.total
        && v.uniB <= v.total
        && v.uniA <= v.total;
    }

    function validSchoolData(d) {
      return d.name is string
        && d.name.size() >= 2
        && d.name.size() <= 180
        && d.responsibleName is string
        && d.responsibleName.size() >= 2
        && d.responsibleName.size() <= 120
        && d.institutionalEmail is string
        && d.institutionalEmail.size() <= 254;
    }

    function validImage(d) {
      return !('image' in d)
        || (d.image is string && d.image.size() < 700000);
    }

    function validUrl(d) {
      return d.url is string && d.url.matches('https?://.+') && d.url.size() <= 2000;
    }

    // ==========================================
    // 2. SCHOOLS
    // ==========================================

    match /schools/{schoolId} {

      // Administrador ou própria escola
      allow get: if isAdmin() || isOwner(schoolId);

      allow list: if isAdmin();

      // Cadastro inicial da escola
      allow create: if isOwner(schoolId)
        && request.resource.data.keys().hasAll([
          'name',
          'responsibleName',
          'institutionalEmail',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'responsibleName',
          'institutionalEmail',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.responsibleName is string
        && request.resource.data.institutionalEmail is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;

      // Administrador: (a) aprova, rejeita ou suspende; (b) edita o cadastro e libera/bloqueia a edição pela escola.
      // Escola: só edita o próprio cadastro quando o administrador liberou (editEnabled) e a liberação é consumida ao salvar.
      allow update: if (
          isAdmin()
          && (
            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'status',
                  'statusBy',
                  'statusAt'
                ])
              && request.resource.data.status in [
                'pending',
                'approved',
                'rejected',
                'suspended'
              ]
              && request.resource.data.statusBy == request.auth.uid
              && request.resource.data.statusAt is timestamp
            )
            || (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'name',
                  'responsibleName',
                  'institutionalEmail',
                  'editEnabled',
                  'updatedAt',
                  'updatedBy'
                ])
              && validSchoolData(request.resource.data)
              && (!('editEnabled' in request.resource.data) || request.resource.data.editEnabled is bool)
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.updatedAt is timestamp
            )
          )
        )
        || (
          isOwner(schoolId)
          && resource.data.get('editEnabled', false) == true
          && request.resource.data.editEnabled == false
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'name',
              'responsibleName',
              'institutionalEmail',
              'editEnabled',
              'updatedAt'
            ])
          && validSchoolData(request.resource.data)
          && request.resource.data.updatedAt is timestamp
        );

      // Exclusão não permitida pelo cliente
      allow delete: if false;
    }

    // ==========================================
    // 3. SURVEYS
    // ==========================================

    match /surveys/{surveyId} {

      // Pesquisas publicadas para escolas aprovadas
      allow read: if isAdmin()
        || (
          schoolApproved()
          && resource.data.status == 'published'
        );

      // Administrador possui CRUD completo
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 4. SUBMISSIONS
    // ==========================================

    match /submissions/{submissionId} {

      // Consulta do próprio envio
      allow get: if isAdmin()
        || (
          signed()
          && resource.data.schoolId == request.auth.uid
        );

      // Listagem administrativa ou da própria escola
      allow list: if isAdmin()
        || (
          signed()
          && resource.data.schoolId == request.auth.uid
        );

      // Criação de respostas
      allow create: if schoolApproved()
        && request.resource.data.schoolId == request.auth.uid
        && request.resource.data.surveyId is string
        && submissionId ==
          request.resource.data.surveyId + '_' + request.auth.uid
        && surveyPublished(request.resource.data.surveyId)
        && request.resource.data.keys().hasAll([
          'schoolId',
          'schoolName',
          'surveyId',
          'surveyTitle',
          'period',
          'surveyVersion',
          'vals',
          'extra',
          'questionsSnapshot',
          'status',
          'updatedAt',
          'reviewNotes',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'schoolId',
          'schoolName',
          'surveyId',
          'surveyTitle',
          'period',
          'surveyVersion',
          'vals',
          'extra',
          'questionsSnapshot',
          'status',
          'updatedAt',
          'submittedAt',
          'reviewNotes',
          'createdAt'
        ])
        && request.resource.data.status in [
          'draft',
          'pending'
        ]
        && request.resource.data.reviewNotes == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.status != 'pending'
          || validVals(request.resource.data.vals)
        );

      // Atualização dos próprios rascunhos ou correções
      allow update: if isAdmin()
        || (
          schoolApproved()
          && resource.data.schoolId == request.auth.uid
          && resource.data.status in [
            'draft',
            'correction'
          ]
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.surveyId == resource.data.surveyId
          && submissionId ==
            resource.data.surveyId + '_' + request.auth.uid
          && surveyPublished(resource.data.surveyId)
          && request.resource.data.status in [
            'draft',
            'pending'
          ]
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'vals',
              'extra',
              'questionsSnapshot',
              'surveyVersion',
              'status',
              'updatedAt',
              'submittedAt',
              'surveyTitle',
              'period',
              'schoolName'
            ])
          && (
            request.resource.data.status != 'pending'
            || validVals(request.resource.data.vals)
          )
        );

      // Exclusão não permitida pelo cliente
      allow delete: if false;
    }

    // ==========================================
    // 5. AGGREGATED RESULTS
    // ==========================================
    // Plano gratuito: sem Cloud Functions. O painel do administrador recalcula
    // os agregados ao revisar um envio. Nunca publica abaixo de 5 envios aprovados.

    match /aggregatedResults/{resultId} {

      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.data.surveyId == resultId
        && request.resource.data.approvedSubmissionCount is number
        && request.resource.data.approvedSubmissionCount >= 5
        && request.resource.data.schoolCount is number
        && request.resource.data.participants is number
        && request.resource.data.impactNum is number
        && request.resource.data.contNum is number
        && request.resource.data.uniBNum is number
        && request.resource.data.uniANum is number;

      allow delete: if isAdmin();
    }

    // ==========================================
    // 6. PUBLIC STATS
    // ==========================================

    match /publicStats/{statId} {

      allow read: if true;

      allow create, update: if isAdmin()
        && statId == 'summary'
        && request.resource.data.schools is number;

      allow delete: if false;
    }

    // ==========================================
    // 7. ADMIN PROFILES
    // ==========================================

    match /adminProfiles/{adminId} {

      allow read: if isAdmin();

      // Gravado apenas pelos scripts de administrador (Admin SDK, na sua máquina)
      allow write: if false;
    }

    // ==========================================
    // 8. AUDIT LOGS
    // ==========================================

    match /auditLogs/{logId} {

      allow read: if isAdmin();

      // O administrador registra a própria ação; ninguém altera ou apaga registros.
      allow create: if isAdmin()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'action', 'resource', 'resourceId', 'timestamp'
        ])
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    // ==========================================
    // 9. SITE CONTENT
    // ==========================================

    match /siteContent/{contentId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 10. GALLERY
    // ==========================================

    match /gallery/{imageId} {

      allow read: if true;

      allow create, update: if isAdmin() && validImage(request.resource.data);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 11. INTERVIEWS
    // ==========================================

    match /interviews/{interviewId} {

      allow read: if isAdmin()
        || resource.data.publicationStatus == 'published';

      allow create, update: if isAdmin() && validImage(request.resource.data);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 12. DOCUMENTS
    // ==========================================

    match /documents/{documentId} {

      allow read: if isAdmin()
        || resource.data.publicationStatus == 'published';

      // PDFs ficam hospedados fora (link do Drive etc.); o documento guarda só o endereço https.
      allow create, update: if isAdmin() && validUrl(request.resource.data);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 13. BLOQUEIO GLOBAL
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
